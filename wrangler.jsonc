{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starfish-tarot-gateway",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "routes": [
    { "pattern": "tarot.haixing.uk", "custom_domain": true }
  ],
  "vars": {
    "ORIGIN_URL": "https://starfish-tarot.ai-builders.space",
    "DOTS_BASE_URL": "https://note3-prev-api.askdiandian.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starfish-tarot-rate-limit",
      "database_id": "0c249732-cd54-4437-805f-c6150f768a63",
      "migrations_dir": "worker/migrations"
    }
  ]
}
